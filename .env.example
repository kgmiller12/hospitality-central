# Neon Postgres connection string. Leave empty locally to use the built-in PGlite database.
DATABASE_URL=

# Any long random string. Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Anthropic API key for the AI Connection Matchmaker (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public URL of the site, e.g. https://hospitality-central.vercel.app (http://localhost:3000 locally)
NEXT_PUBLIC_APP_URL=http://localhost:3000
